[Unit]
Description=MediaDir backend server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sortedcord
Group=sortedcord
WorkingDirectory=/home/sortedcord/mediadir/server
ExecStart=/home/sortedcord/mediadir/server/target/release/mediadir-server
Environment=DATA_DIR=/home/sortedcord/mediadir/server/data2
Environment=BIND=0.0.0.0:8096
EnvironmentFile=-/home/sortedcord/mediadir/server/service.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0022

[Install]
WantedBy=multi-user.target
